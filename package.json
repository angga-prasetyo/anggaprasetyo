{
  "name": "anggaprasetyo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently \"vite\" \"tsc --watch\"",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview --host",
    "lint": "eslint ./src --ext js,jsx,ts,tsx --fix --ignore-path ./.gitignore --report-unused-disable-directives --max-warnings 0",
    "coverage": "vitest run --coverage",
    "e2e": "pnpm build && playwright test --ui",
    "test": "eslint ./src --ext js,jsx,ts,tsx --fix --ignore-path ./.gitignore --report-unused-disable-directives --max-warnings 0 && vitest run --coverage && pnpm build && playwright test"
  },
